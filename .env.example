# ===== 本地开发（默认 SQLite，schema.prisma）=====
DATABASE_URL="file:./dev.db"

# ===== 生产 / Vercel 部署（Postgres，schema.postgres.prisma）=====
# 在 Vercel 项目 Environment Variables 中填入 Neon 连接串，格式：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT 密钥（生产请换成强随机串，可用 `openssl rand -base64 32` 生成）
JWT_SECRET="dental-recruit-os-change-this-to-a-strong-random-secret"
NEXT_PUBLIC_APP_NAME="Dental Talent Acquisition OS"
